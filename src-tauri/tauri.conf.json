{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AudioScript",
  "version": "0.3.0",
  "identifier": "io.github.envonion.audioscript",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "AudioScript",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        }
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 80,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "width": 520,
        "height": 160
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/envOnion/AudioScript/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyRTdGRTczOTI5MzIzNjUKUldSbEk1T1NjLzduSW5xQ0NnUWkzait4UlJWRnZTNTBoYklQMW1MN1ZRNUM1aG44TDA1N2xVRkoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "assets/models": "models"
    },
    "shortDescription": "Офлайн-субтитры и перевод английский ↔ русский",
    "longDescription": "AudioScript распознаёт системный звук и речь с микрофона и показывает английские и русские субтитры. Распознавание и перевод работают на устройстве.",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}
