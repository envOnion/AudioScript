{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Разрешения главного окна и субтитров: события приложения, перемещение и изменение размера окна",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "core:event:allow-listen",
      "allow": [
        {
          "event": "transcript://*"
        },
        {
          "event": "overlay://*"
        },
        {
          "event": "models://*"
        },
        {
          "event": "update://*"
        }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
