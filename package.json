{
  "name": "audioscript",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Офлайн-субтитры и потоковый перевод английский ↔ русский",
  "license": "MIT",
  "scripts": {
    "gen:types": "typeshare src-tauri --lang=typescript --output-file=src/shared/types.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.app.json --noEmit",
    "lint": "biome check --write src/",
    "format": "biome format --write src/",
    "build:app": "tauri build --debug --bundles app",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/make-icons.mjs",
    "clean:dmg": "bash scripts/clean-dmg.sh",
    "fetch:model": "node scripts/fetch-model.mjs",
    "fetch:model:high": "node scripts/fetch-model.mjs --model high --print-catalog",
    "fetch:mt": "node scripts/fetch-mt-model.mjs",
    "fetch:mt:big": "node scripts/fetch-mt-model.mjs --tier big --print-catalog",
    "verify:models": "node scripts/verify-model-catalog.mjs",
    "prepare": "node scripts/fetch-model.mjs",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
